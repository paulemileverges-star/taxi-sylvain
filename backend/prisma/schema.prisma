generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  DRIVER
  DISPATCH
  ADMIN // collaborateur créé par Taxi Sylvain (Dispatch), avec des permissions limitées (besoin #20)
}

enum RideStatus {
  REQUESTED // demandée par le client ou créée par le dispatch, pas encore affectée
  BROADCAST // envoyée à tous les chauffeurs (course de dernière minute)
  ACCEPTED // affectée / acceptée par un chauffeur
  EN_ROUTE // chauffeur en route pour la prise en charge
  STARTED // course démarrée vers la destination
  COMPLETED // course terminée
  CANCELLED
  REFUSED
}

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  createdAt    DateTime @default(now())

  // Champs spécifiques chauffeur
  carModel    String?
  plate       String?
  ratingAvg   Float?  @default(5.0)
  photoUrl    String? // photo du chauffeur (besoin #13)
  carPhotoUrl String? // photo du véhicule (besoin #13)

  // Mémo interne du Dispatch sur un client (préférences, notes utiles pour personnaliser le
  // service) — jamais montré au client lui-même, visible seulement côté Dispatch.
  notes   String?
  address String?

  // Jeton de notification push (Expo) de l'appareil actuellement connecté — permet d'alerter un
  // chauffeur ou un client même quand l'app est fermée ou l'écran verrouillé.
  pushToken String?

  // Rappels de course programmés (besoin #1) : décalages en minutes avant l'heure de prise en
  // charge auxquels envoyer un rappel push. Ex. [60, 10] = 1h avant et 10min avant. Vide = désactivé.
  reminderOffsets Int[] @default([60, 10])
  sentReminders   SentReminder[]

  // Fonctionnalités accessibles à un compte ADMIN, choisies par le Dispatch à la création
  // (ex. ["courses","clients"]). Sans effet pour les autres rôles — le Dispatch a toujours
  // accès à tout, un ADMIN uniquement à ce qui est listé ici (besoin #20).
  permissions String[] @default([])

  ridesAsClient   Ride[]         @relation("ClientRides")
  ridesAsDriver   Ride[]         @relation("DriverRides")
  messagesSent    Message[]      @relation("MessageSender")
  directMessages  Message[]      @relation("DirectMessages")
  ratingsGiven    Rating[]       @relation("RatingFrom")
  ratingsReceived Rating[]       @relation("RatingTo")
  scheduleEntries Schedule[]
  weeklyReports   WeeklyReport[]

  conversationsCreated Conversation[]            @relation("ConversationCreator")
  conversationsIn      ConversationParticipant[]
  groupMessagesSent    GroupMessage[]            @relation("GroupMessageSender")
}

model Ride {
  id            String     @id @default(cuid())
  status        RideStatus @default(REQUESTED)
  pickupAddress String
  destAddress   String
  pickupLat     Float?
  pickupLng     Float?
  destLat       Float?
  destLng       Float?
  distanceKm    Float?
  fare          Float
  royaltyRate   Float      @default(0.10) // 10% versé à Taxi Sylvain
  flightNumber  String?
  scheduledFor  DateTime?
  createdAt     DateTime   @default(now())
  acceptedAt    DateTime?
  enRouteAt     DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  // Chauffeurs ayant refusé cette course diffusée — elle ne leur est plus proposée, mais reste
  // disponible pour les autres (besoin #6 / correction #17).
  refusedBy     String[]   @default([])

  clientId String?
  client   User?   @relation("ClientRides", fields: [clientId], references: [id])
  driverId String?
  driver   User?   @relation("DriverRides", fields: [driverId], references: [id])

  messages Message[]
  ratings  Rating[]
}

model Message {
  id        String   @id @default(cuid())
  // Message lié à une course (chauffeur<->client) — mutuellement exclusif avec driverId ci-dessous.
  rideId    String?
  ride      Ride?    @relation(fields: [rideId], references: [id])
  // Message direct dispatch<->chauffeur, hors contexte d'une course (besoin #4).
  // Identifie le fil de discussion (toujours l'id du chauffeur, peu importe qui écrit).
  driverId  String?
  driver    User?    @relation("DirectMessages", fields: [driverId], references: [id])
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id])
  fromUserId String
  fromUser   User     @relation("RatingFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingTo", fields: [toUserId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
}

// Destinations prédéfinies (YUL, YHU, REM...) avec tarif du catalogue — proposées au Dispatch et
// au client à la création d'une course ; le tarif s'applique automatiquement quand il est renseigné.
model Destination {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String
  address   String
  lat       Float?
  lng       Float?
  price     Float? // null = montant à confirmer par le Dispatch
  sortOrder Int     @default(0)
}

// Grille tarifaire par municipalité de prise en charge vers les aéroports (catalogue Taxi Sylvain).
// Le nom sert à reconnaître la municipalité dans l'adresse de départ ; null = pas de tarif.
model PriceZone {
  id        String @id @default(cuid())
  name      String @unique
  priceYUL  Float?
  priceYHU  Float?
  sortOrder Int    @default(0)
}

// Trace des rappels de course déjà envoyés, pour ne jamais en envoyer deux fois au même
// utilisateur pour le même décalage (besoin #1).
model SentReminder {
  id             String   @id @default(cuid())
  rideId         String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offsetMinutes  Int
  sentAt         DateTime @default(now())

  @@unique([rideId, userId, offsetMinutes])
}

model Schedule {
  id        String   @id @default(cuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  label     String // ex. "Lun 09h00 · Aéroport → Centre-ville"
  startsAt  DateTime
  createdAt DateTime @default(now())
}

// Groupe de discussion créé par le Dispatch, avec les correspondants de son choix
// (un ou plusieurs chauffeurs et/ou clients).
model Conversation {
  id          String   @id @default(cuid())
  name        String?
  createdById String
  createdBy   User     @relation("ConversationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     GroupMessage[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model GroupMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("GroupMessageSender", fields: [senderId], references: [id])
  text           String
  createdAt      DateTime     @default(now())
}

// Récap hebdomadaire figé par chauffeur (besoin #14) — généré automatiquement chaque semaine
// (voir src/jobs/weeklyReport.js), consultable dans l'app et exportable en PDF/Excel.
model WeeklyReport {
  id         String   @id @default(cuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id])
  weekStart  DateTime
  weekEnd    DateTime
  rideCount  Int
  totalFare  Float
  royaltyDue Float
  createdAt  DateTime @default(now())

  @@unique([driverId, weekStart])
}
