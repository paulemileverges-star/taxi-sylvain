DATABASE_URL="postgresql://user:password@localhost:5432/taxi_sylvain"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Masquage d'appel (besoin #2, optionnel) — via Twilio Proxy, voir docs/ARCHITECTURE.md §3.
# Tant que ces 3 variables ne sont pas renseignées, le bouton "Appeler (masqué)" reste inactif
# (l'app affiche un message clair) — le reste de l'application fonctionne normalement sans elles.
# 1. Créer un compte sur twilio.com, acheter un numéro de téléphone (Phone Numbers).
# 2. Créer un "Proxy Service" (Console > Proxy > Services) et copier son SID (commence par KS...).
# 3. Copier Account SID et Auth Token depuis le tableau de bord Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PROXY_SERVICE_SID=""
