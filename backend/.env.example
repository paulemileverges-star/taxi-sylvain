DATABASE_URL="postgresql://user:password@localhost:5432/taxi_sylvain"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Origines web autorisées, séparées par des virgules ("*" pour tout autoriser en développement).
# En production : les adresses taxisylvain.ca (racine, www, dispatch, chauffeur, client) et les anciennes
# adresses vercel.app. Les apps natives (APK) ne sont pas concernées.
CORS_ORIGIN="http://localhost:5173"

# Masquage d'appel (besoin #2, optionnel) — via Twilio Proxy, voir docs/ARCHITECTURE.md §3.
# Tant que ces 3 variables ne sont pas renseignées, le bouton "Appeler (masqué)" reste inactif
# (l'app affiche un message clair) — le reste de l'application fonctionne normalement sans elles.
# 1. Créer un compte sur twilio.com, acheter un numéro de téléphone (Phone Numbers).
# 2. Créer un "Proxy Service" (Console > Proxy > Services) et copier son SID (commence par KS...).
# 3. Copier Account SID et Auth Token depuis le tableau de bord Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PROXY_SERVICE_SID=""

# Courriels automatiques de course + invitation d'agenda (.ics) — optionnel.
# Tant qu'aucune clé n'est renseignée, aucun courriel n'est envoyé et le reste fonctionne.
# Un seul fournisseur suffit, au choix :
#   Brevo  : compte gratuit sur brevo.com, menu SMTP & API > Cles API. Fait aussi les SMS.
#   Resend : compte sur resend.com, menu API Keys.
# Dans les deux cas, le domaine de MAIL_FROM doit etre verifie chez le fournisseur (DNS).
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM="Taxi Sylvain <reservations@votre-domaine.ca>"
# Liens mis dans les courriels.
DRIVER_APP_URL="https://chauffeur.taxisylvain.ca"
CLIENT_APP_URL="https://client.taxisylvain.ca"
